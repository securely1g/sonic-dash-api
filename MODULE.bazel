module(
    name = "sonic-dash-api",
    version = "0.0.5",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "googletest", version = "1.14.0.bcr.1", repo_name = "com_google_googletest")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.5")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "protobuf-legacy", version = "3.21.12.sonic.2", repo_name = "protobuf_legacy")
bazel_dep(name = "sonic-build-infra", version = "0.0.16-2b4e9d49b0fe7e8152461d03aae90caf61629907", repo_name = "sonic_build_infra")

# Historical dotted versions requested by dependencies sort above this native fix.
single_version_override(
    module_name = "rules_distroless",
    version = "0.9.4.sonic.5",
)

# Native execution and target toolchains share the pinned SONiC Trixie inputs.
gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

register_toolchains("@python_3_13//:all")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "dash_pypi",
    python_version = "3.13",
    requirements_lock = "//bazel:requirements_lock.txt",
)
use_repo(pip, "dash_pypi")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
use_repo(apt, "trixie")

apt.install(
    dependency_set = "dash_test_debian",
    packages = [
        "libboost-filesystem-dev",
        "libboost-system-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "dash_test_debian")

bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")

apt.install(
    dependency_set = "dash_package_deps",
    packages = [
        "libc6",
        "libgcc-s1",
        "libpython3.13",
        "libstdc++6",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "dash_package_deps")

bsdtar = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(bsdtar, "bsd_tar_toolchains")

# Keep the SONiC tar timestamp feature when stock releases sort higher.
single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5-sonic.1",
)

# Keep the reviewed package tools selected across older source dependencies.
single_version_override(
    module_name = "sonic-build-infra",
    version = "0.0.16-2b4e9d49b0fe7e8152461d03aae90caf61629907",
)
