module(
    name = "sonic-dash-api",
    version = "0.0.2",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "googletest", version = "1.14.0.bcr.1", repo_name = "com_google_googletest")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.2")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "protobuf-debian", version = "3.21.12-sonic.1", repo_name = "protobuf_debian")
bazel_dep(name = "sonic-build-infra", version = "0.0.10-7bc84c13cb812d0cf576485009352bbc96dde00a", repo_name = "sonic_build_infra")

# Native execution and target toolchains share the pinned SONiC Trixie inputs.
gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

register_toolchains("@python_3_13//:all")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "dash_pypi",
    python_version = "3.13",
    requirements_lock = "//bazel:requirements_lock.txt",
)
use_repo(pip, "dash_pypi")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
use_repo(apt, "trixie")

apt.install(
    dependency_set = "dash_test_debian",
    packages = [
        "libboost-filesystem-dev",
        "libboost-system-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "dash_test_debian")
